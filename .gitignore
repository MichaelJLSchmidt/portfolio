# dependencies
/node_modules

# build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# terrain pipeline: raw downloads and intermediate rasters
/scripts/terrain/.cache/
# font sources for npm run fonts:subset
/scripts/site/.cache/
# optional PNG copies of the heightmaps (npm run terrain -- --png)
/public/terrain/**/*.png
# lossless PNG masters of the artefact images (npm run images regenerates them)
/artefacts/.masters/
# review videos (npm run record:motion)
/motion-recordings/

# env files (MOTION_TOKEN and friends never get committed)
.env
.env.*
!.env.example

# tooling
/coverage
/.netlify
/.vercel
.DS_Store
*.pem
npm-debug.log*
