# Copy to .env.local for local development. Never commit real values.
# MOTION_TOKEN must also be exported in your shell for `npm install` (npm does not read .env files).
MOTION_TOKEN=
# Sub-path the site is built for. Empty on Netlify (domain root); "/portfolio" tests asset() locally.
NEXT_PUBLIC_BASE_PATH=
# "1" on preview builds: adds noindex meta and a disallow-all robots.txt.
NEXT_PUBLIC_PREVIEW=
# What `npm run build` produces: construction, basecamp or live (default live). Netlify sets it per
# deploy context in netlify.toml.
SITE_MODE=
# The Basecamp gate's password. On Netlify set it in the UI (Functions scope). Locally only
# `npm run test:hosting` needs one, and it writes its own temporary .env.development.local.
BASECAMP_PASSWORD=
