# Copy to .env.local for local development. Never commit real values.
# MOTION_TOKEN must also be exported in your shell for `npm install` (npm does not read .env files).
MOTION_TOKEN=
# Sub-path the site is served from. Empty for a root domain, "/<repo>" for GitHub Pages.
NEXT_PUBLIC_BASE_PATH=
# "1" on preview builds: adds noindex meta and a disallow-all robots.txt.
NEXT_PUBLIC_PREVIEW=
