{
  "name": "summit-deck-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/site/build.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "terrain": "node scripts/terrain/build.mjs",
    "terrain:bern": "node scripts/terrain/bern.mjs",
    "terrain:field": "node scripts/terrain/field.mjs",
    "posters": "node scripts/terrain/posters.mjs",
    "plates": "node scripts/plates/build.mjs",
    "geo": "node scripts/geo/build.mjs",
    "images": "node scripts/images/build.mjs",
    "portrait": "node scripts/portrait.mjs",
    "verify:terrain": "node scripts/terrain/verify.mjs",
    "report:size": "node scripts/report-sizes.mjs",
    "report:transfer": "node scripts/report-transfer.mjs",
    "report:motion": "node scripts/report-motion.mjs",
    "record:motion": "node scripts/record-motion.mjs",
    "preview": "node scripts/serve-out.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:legibility": "node scripts/check-legibility.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:figures": "node scripts/check-figures.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:name": "node scripts/check-name.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:hosting": "node scripts/e2e-hosting.mjs",
    "test": "node --import ./scripts/lib/ts-hooks.mjs --test src/hosting/*.test.ts src/styles/*.test.ts src/lib/*.test.ts",
    "fonts:subset": "node scripts/site/fonts.mjs"
  },
  "dependencies": {
    "lenis": "1.3.27",
    "motion": "14.5.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.10.3",
    "d3-contour": "4.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "geotiff": "3.0.5",
    "leva": "0.10.1",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typescript": "5.9.3"
  }
}
