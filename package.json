    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "d3-contour": "4.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "geotiff": "3.0.5",
