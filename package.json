{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-numerals.mjs && next build && node scripts/i18n-pages.mjs",
    "preview": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"content/**/*.json\" \"*.{ts,json,md}\""
  },
  "dependencies": {
    "motion": "14.10.1",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "optionalDependencies": {
    "motion-plus": "npm:@motionplus/core@4.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "fontkit": "2.0.4",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
