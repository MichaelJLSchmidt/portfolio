{
  "name": "summit-deck-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/check-content.mjs --build",
    "build": "next build",
    "lint": "eslint .",
